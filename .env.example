NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
PLATFORM_ADMIN_SECRET=
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5-nano

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Ads (Facebook Pixel)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here
# Gerado no Gerenciador de Eventos do Meta (Conversions API). Nunca use NEXT_PUBLIC_ nesta variável — é secreta.
META_CONVERSIONS_API_TOKEN=your_meta_conversions_api_token_here

# Asaas: use https://api-sandbox.asaas.com/v3 para testar e
# https://api.asaas.com/v3 somente quando estiver pronto para cobrar de verdade.
ASAAS_API_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
